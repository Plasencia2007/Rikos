# Copiar a .env y completar. El archivo .env NO se sube al repositorio.

DB_USER=rikos
DB_PASS=rikos

RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=rikos
RABBIT_PASS=rikos

# Identificador del local. Solo aplica al perfil "local".
LOCAL_ID=sanisidro

# Firma de los tokens de sesion (US-002). Minimo 32 bytes. En produccion
# es un secreto real, nunca el valor de desarrollo del application.yaml.
JWT_SECRET=

# Bloqueo por intentos fallidos (US-003, RF-006 pendiente de definicion).
PIN_UMBRAL_INTENTOS=5
PIN_MINUTOS_BLOQUEO=15

# Proveedor de facturacion electronica.
# El token emite comprobantes tributarios a nombre de la empresa:
# se trata como una credencial bancaria y nunca se escribe en el codigo.
FACTIVO_URL=
FACTIVO_TOKEN=
FACTIVO_SERIE_BOLETA=
FACTIVO_SERIE_FACTURA=
