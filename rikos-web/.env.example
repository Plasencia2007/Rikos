# En desarrollo se deja vacia: el proxy de Vite se encarga.
VITE_API_BASE=

# DT-029: codigo del local que sirve este equipo (el POS/kiosco de un
# restaurante concreto). En produccion cada equipo tiene el suyo; en
# desarrollo coincide con el local semilla del backend.
VITE_LOCAL_CODIGO=sanisidro

# US-003: minutos de inactividad antes de volver sola a la pantalla de PIN.
# Sin esto la tablet queda abierta con el mozo anterior.
VITE_POS_MINUTOS_INACTIVIDAD=5
